  "item": [
    {
      "name": "1. Professores",
      "item": [
        {
          "name": "1.1 Cadastrar Professor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code deve ser 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Deve retornar id gerado e dados corretos\", function () {",
                  "    pm.expect(jsonData.id).to.be.a('number');",
                  "    pm.expect(jsonData.nome).to.eql(\"Dr. Roberto Martins\");",
                  "    pm.expect(jsonData.email).to.eql(\"roberto.martins@unasp.br\");",
                  "});",
                  "",
                  "// Salva o professorId automaticamente para os proximos testes",
                  "pm.collectionVariables.set(\"professorId\", jsonData.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Dr. Roberto Martins\",\n  \"email\": \"roberto.martins@unasp.br\",\n  \"departamento\": \"Tecnologia da Informacao\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/professor",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "professor"
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.2 Listar Todos os Professores",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code deve ser 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Deve retornar uma lista com pelo menos 1 professor\", function () {",
                  "    pm.expect(jsonData).to.be.an('array').that.is.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/professor",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "professor"
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.3 Buscar Professor por ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code deve ser 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Deve conter os dados do professor pesquisado\", function () {",
                  "    pm.expect(jsonData.id).to.eql(pm.collectionVariables.get(\"professorId\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/professor/{{professorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "professor",
                "{{professorId}}"
              ]
            }
          },
          "response": []
        }
